rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null && userDoc().role == 'admin';
    }
    function isEditorFor(id) {
      return request.auth != null && userDoc().role == 'editor'
        && id in userDoc().editableCharacterIds;
    }
    function isEditor() {
      return request.auth != null && userDoc().role == 'editor';
    }

    match /characters/{id} {
      allow read: if true;
      allow write: if isAdmin() || isEditorFor(id);
    }

    /* ── Inventories ───────────────────────────────────────────────────
       Money and gear, kept apart from the character bundle so a rule can
       be written about them at all.

       While inventory lived inside relationships-bundle there was nothing
       to enforce: a purchase and a hand-edit were the same shape of write
       to the same document, and the rules language has no loops to walk
       twenty characters checking whose purse moved. One document per
       character makes the question answerable.

       The rule below was, for most of this project's life:

         a player may write an inventory, but never one whose purse is
         worth more than the purse already there.

       Spending is a decrease, so the Shop and the Eats app worked
       untouched, and giving yourself ¥10,000 was refused by the database
       rather than by a check in a page the player controls.

       That has been relaxed, deliberately: a player may now set their OWN
       purse to anything, because at a real table the player is the one who
       knows what they were just handed, and the DM was spending their
       evening typing it in. What stops that being a hole is that the edit
       is not silent — it writes its own line to the Bank statement in the
       same transaction, so the DM can see every adjustment and who made
       it. The monotonic rule still governs everybody else's purse, which
       is what keeps the Shop working and keeps a player out of another
       player's money. The DM remains unrestricted.

       ── What this does NOT stop ──────────────────────────────────────
       · Adding items, parts or points out of thin air. Only the purse is
         valued, because only the purse has a handbook exchange rate to
         value it by.
       · One player spending another player's money. Spending is a
         decrease, so the third clause below permits it for any editor —
         which is what lets the Shop work at all. Ownership now scopes who
         may *raise* a purse, not who may lower one.
       · A player raising their own purse without the DM noticing. It is
         allowed on purpose now, and the audit trail rather than the rule
         is what makes it answerable: the write and its Bank-statement line
         land in one transaction (see saveInventoryCurrency).
       ─────────────────────────────────────────────────────────────── */
    function purseValue(inv) {
      return inv.get('currency', {}).get('yen', 0)
           + inv.get('currency', {}).get('cp', 0) * 10
           + inv.get('currency', {}).get('sp', 0) * 100
           + inv.get('currency', {}).get('ep', 0) * 500
           + inv.get('currency', {}).get('gp', 0) * 1000
           + inv.get('currency', {}).get('pp', 0) * 10000;
    }

    match /inventories/{characterFile} {
      allow read: if true;

      // Creating one is how a character's inventory first arrives, so it
      // is admin-only — the migration on the admin page does it.
      allow create: if isAdmin();

      /* Three ways an inventory may be written, in descending trust:

         · THE DM, without restriction. Grants are supposed to add money.

         · ITS OWNER, in any direction. A player may set their own purse to
           whatever it should be — they are the one at the table who knows
           what they were handed. Every such edit writes a line to the Bank
           statement from the same transaction, so "no record of it" — the
           reason this was once refused outright — is no longer the trade.

           Keyed on editableCharacterFiles, NOT editableCharacterIds. The two
           are different key spaces and conflating them is why this rule was
           unscoped for so long: an inventory document is named for a roster
           file ("kibi_kankei.json") while editableCharacterIds holds
           "Student (1-A)::Kibi Kankei". admin.js writes both.

         · ANYBODY WHO MAY EDIT SHEETS, but only downwards. This is what the
           Shop and the Eats app ride on, and it is kept exactly as it was so
           a purchase cannot be refused mid-checkout. It also still refuses a
           player inventing money on somebody else's sheet. */
      allow update: if isAdmin()
        || (isEditor()
            && characterFile in userDoc().get('editableCharacterFiles', []))
        || (isEditor()
            && purseValue(request.resource.data) <= purseValue(resource.data));

      // Nothing legitimate deletes an inventory.
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == 'pending';
      allow update, delete: if isAdmin();
    }

    match /mha-dnd/{doc} {
      allow read: if true;
      // encounter-state is the shared battle board — an 'editor' role only
      // grants edit rights to a player's own character sheet (see
      // isEditorFor above), so it must NOT double as board-write access.
      //
      // masaranking is the class ranking chart on the Heropad. It is the DM's
      // to keep, and the whole joke is that the people on it can't touch it —
      // so it is admin-only for the same reason. Hiding the controls in the
      // UI would not be enough: every player holds an 'editor' role, and the
      // rule below is the only thing standing between them and a console.
      //
      // heat is the Byakko Heat track, and it joins them for the same reason
      // with a sharper edge: Heat decides whether a Corner comes down and
      // whether there is a note on the Heights Alliance doormat. A player who
      // can set it to 10 can summon the White Tiger, which is the campaign's
      // final encounter. Everybody reads it — that is the point of putting it
      // where the players can see it — and only the DM moves it.
      //
      // Every other mha-dnd doc (campaigns, dm-scripts, session-log, and the
      // per-player heropad-* pads) keeps the existing admin-or-editor policy.
      allow write: if isAdmin()
        || (isEditor() && doc != 'encounter-state' && doc != 'masaranking'
            && doc != 'heat');
    }
  }
}
