rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null && userDoc().role == 'admin';
    }
    function isEditorFor(id) {
      return request.auth != null && userDoc().role == 'editor'
        && id in userDoc().editableCharacterIds;
    }
    function isEditor() {
      return request.auth != null && userDoc().role == 'editor';
    }

    match /characters/{id} {
      allow read: if true;
      allow write: if isAdmin() || isEditorFor(id);
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == 'pending';
      allow update, delete: if isAdmin();
    }

    match /mha-dnd/{doc} {
      allow read: if true;
      // encounter-state is the shared battle board — an 'editor' role only
      // grants edit rights to a player's own character sheet (see
      // isEditorFor above), so it must NOT double as board-write access.
      // Every other mha-dnd doc (campaigns, dm-scripts, session-log, etc.)
      // keeps the existing admin-or-editor policy.
      allow write: if isAdmin() || (isEditor() && doc != 'encounter-state');
    }
  }
}
