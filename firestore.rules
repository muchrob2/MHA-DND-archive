rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return request.auth != null && userDoc().role == 'admin';
    }
    function isEditorFor(id) {
      return request.auth != null && userDoc().role == 'editor'
        && id in userDoc().editableCharacterIds;
    }
    function isEditor() {
      return request.auth != null && userDoc().role == 'editor';
    }

    match /characters/{id} {
      allow read: if true;
      allow write: if isAdmin() || isEditorFor(id);
    }

    // ── Inventories: readable by all, writable by nobody ──────────────
    // This is the whole point of the Cloud Functions. Money and gear live
    // here, apart from the player-writable character bundle, and NO client
    // may write them — not a player, not the DM, not a console.
    //
    // `allow write: if false` is not a placeholder. The Admin SDK inside a
    // Cloud Function bypasses rules entirely, so the functions still write
    // freely; everyone else is refused by the database itself rather than
    // by a check in a page they control.
    //
    // Rules alone could never have done this job while inventory sat inside
    // the bundle: a purchase and a hand-edit are the same shape of write to
    // the same document, and the rules language has no loops to walk twenty
    // characters checking that only the caller's purse moved, and only
    // downwards. Moving the data is what made the rule expressible.
    match /inventories/{characterFile} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == 'pending';
      allow update, delete: if isAdmin();
    }

    match /mha-dnd/{doc} {
      allow read: if true;
      // encounter-state is the shared battle board — an 'editor' role only
      // grants edit rights to a player's own character sheet (see
      // isEditorFor above), so it must NOT double as board-write access.
      //
      // masaranking is the class ranking chart on the Heropad. It is the DM's
      // to keep, and the whole joke is that the people on it can't touch it —
      // so it is admin-only for the same reason. Hiding the controls in the
      // UI would not be enough: every player holds an 'editor' role, and the
      // rule below is the only thing standing between them and a console.
      //
      // The ledger is the record of every movement of money. It is only
      // trustworthy if nothing but the Cloud Functions can write it — a
      // client that can forge a statement line can hide a theft, and the
      // Bank app exists to be believed. Functions bypass rules, so they
      // still write it; every client is refused.
      //
      // Every other mha-dnd doc (campaigns, dm-scripts, session-log, and the
      // per-player heropad-* pads) keeps the existing admin-or-editor policy.
      allow write: if doc != 'ledger'
        && (isAdmin() || (isEditor() && doc != 'encounter-state' && doc != 'masaranking'));
    }
  }
}
